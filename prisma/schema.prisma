// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id            Int       @id
  name          String
  nameAr        String
  category      String
  categoryAr    String
  price         Float
  originalPrice Float?
  discount      Int?
  rating        Float     @default(0)
  reviews       Int       @default(0)
  sold          Int       @default(0)
  images        String    // JSON-encoded array of URLs
  colors        String    // JSON-encoded array of {name,hex}
  sizes         String    // JSON-encoded array of strings
  description   String
  descriptionAr String
  badge         String?
  vendor        String    @default("Modave")
  sku           String
  stock         Int       @default(0)
  featured      Boolean   @default(false)
  bestSeller    Boolean   @default(false)
  newArrival    Boolean   @default(false)
  status        String    @default("active") // active | draft
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([category])
  @@index([status])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerName    String
  customerEmail   String
  customerPhone   String?
  country         String
  town            String
  street          String
  postal          String?
  note            String?
  items           String        // JSON-encoded array
  subtotal        Float
  discount        Float         @default(0)
  shipping        Float         @default(0)
  total           Float
  paymentMethod   String
  status          String        @default("paid") // paid | pending | cancelled
  estimatedDelivery DateTime?
  createdAt       DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  passwordHash String?
  phone     String?
  orders    Int      @default(0)
  totalSpent Float   @default(0)
  tier      String   @default("New") // VIP | Regular | New
  notes     String?
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([tier])
}

// The store has exactly one dashboard administrator. `isPrimary` is unique so
// SQLite cannot contain a second admin record.
model Admin {
  id           String   @id @default(cuid())
  isPrimary    Boolean  @default(true) @unique
  name         String   @default("Store Admin")
  email        String   @unique
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId Int
  author    String
  email     String?
  rating    Int      // 1-5
  title     String?
  body      String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model BlogPost {
  id          Int       @id
  title       String
  titleAr     String
  excerpt     String
  excerptAr   String
  content     String    @default("")
  contentAr   String    @default("")
  category    String
  categoryAr  String
  author      String
  authorAr    String
  date        String
  readTime    Int       @default(5)
  image       String
  featured    Boolean   @default(false)
  status      String    @default("published")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model Category {
  id        Int       @id
  name      String
  nameAr    String
  slug      String    @unique
  image     String
  itemCount Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active])
}

model SiteSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model HeroSlide {
  id         Int      @id @default(autoincrement())
  image      String
  eyebrow    String
  eyebrowAr  String
  title      String
  titleAr    String
  subtitle   String
  subtitleAr String
  cta        String
  ctaAr      String
  href       String
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Testimonial {
  id      Int    @id @default(autoincrement())
  text    String
  name    String
  role    String
  product String
  price   String
  avatar  String
  order   Int    @default(0)
  active  Boolean @default(true)
}

model ShippingOption {
  id      Int    @id @default(autoincrement())
  label   String
  labelAr String
  price   Float  @default(0)
  active  Boolean @default(true)
}

model Coupon {
  id        String   @id @default(cuid())
  code      String   @unique
  type      String   @default("percentage")
  value     Float    @default(10)
  active    Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())
}
