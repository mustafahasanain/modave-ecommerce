DATABASE_URL="file:./db/custom.db"
ADMIN_EMAIL="admin@modave.com"
ADMIN_PASSWORD="admin123"

# Secrets for signing session cookies. Generate with: openssl rand -hex 32
# Required in production — the app throws at startup if these are unset.
ADMIN_SESSION_SECRET=""
CUSTOMER_SESSION_SECRET=""

# Public site URL, used for sitemap.xml and product OpenGraph/canonical URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Directory for admin-uploaded images. Must live outside public/ and .next/.
# In standalone production the process runs from .next/standalone, so set this
# to an absolute path on a persistent volume (e.g. /var/lib/modave/uploads).
UPLOADS_DIR=""
